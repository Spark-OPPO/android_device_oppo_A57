prebuilt_etc_xml {
    name: "A57_camera_config.xml",

    required: [
        "imx258_chromatix.xml",
        "imx258_truly_chromatix.xml",
        "ov13855_f13v08b_chromatix.xml",
        "s5k3l8_chromatix.xml",
        "s5k3p3sp_chromatix.xml",
        "s5k3p3sp_ofilm_chromatix.xml",
        "s5k3p3sp_sunny_chromatix.xml",
        "s5k3p8sp_chromatix.xml",
        "s5k3p8sp_sunny_chromatix.xml",
    ],
    src: "camera_config.xml",
    relative_install_path: "camera",
    filename_from_src: true,
    soc_specific: true,
}
